{
  "info": {
    "name": "FlowDesk",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cookie-based API collection. Set IDs after creating resources. Resume and Stripe webhook requests require multipart/signature configuration."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5003/api"
    },
    {
      "key": "password",
      "value": "set-your-SEED_PASSWORD"
    },
    {
      "key": "idempotencyKey",
      "value": "unique-checkout-key-001"
    }
  ],
  "item": [
    {
      "name": "POST /auth/register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-App-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"replace-with-demo-password\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "POST /auth/login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "X-App-Request",
            "value": "1"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@flowdesk.demo\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "POST /auth/logout",
